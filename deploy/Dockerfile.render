# One container for a free Render web service (512 MB, no disk): FalkorDB and the API side by side. At run time
# FalkorDB listens on a unix socket only (FALKOR_SOCKET), with no TCP port.
#   docker build -f deploy/Dockerfile.render -t unlearn-render .
#   docker run --rm -p 8000:10000 -e PORT=10000 unlearn-render
# FalkorDB's redis-server and module are copied from the pinned image (both images are Debian trixie). The
# graphs (curriculum, class_template, class_demo, class_demo_video) are built at image build time and saved as
# dump.rdb, so a cold start loads them in seconds instead of seeding. Writes are never saved: demo state resets
# on every restart. The local docker-compose setup does not use this file.
FROM falkordb/falkordb:v4.20.7 AS falkordb

FROM python:3.12-slim

# falkordb.so needs libgomp; redis-server's other libraries are already in the slim image.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=falkordb /usr/local/bin/redis-server /usr/local/bin/redis-cli /usr/local/bin/
COPY --from=falkordb /var/lib/falkordb/bin/falkordb.so /opt/falkordb/falkordb.so

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.cache/huggingface \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed \
    PYTHONPATH=/app/api:/app \
    FALKOR_HOST=127.0.0.1 \
    FALKOR_PORT=6379 \
    MALLOC_ARENA_MAX=2

RUN useradd --create-home --uid 10001 unlearn && mkdir -p /app/falkordb-data && chown -R unlearn /app
WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

USER unlearn

# Bake the embedding model (all-MiniLM-L6-v2, ONNX via fastembed).
COPY --chown=unlearn api/unlearn/embed.py /tmp/embed.py
RUN python -c "import sys; sys.path.insert(0, '/tmp'); from embed import embed; embed(['warm up'])" \
 && rm /tmp/embed.py

COPY --chown=unlearn api ./api
COPY --chown=unlearn scripts ./scripts
COPY --chown=unlearn eval ./eval
COPY --chown=unlearn data/curated ./data/curated

# Bake the pinned Eedi CSVs (CC BY 4.0), then build every graph into dump.rdb with a throwaway FalkorDB
# (no password: it only listens on loopback inside this build step).
RUN python scripts/01_download.py \
 && redis-server --bind 127.0.0.1 --port 6379 --dir /app/falkordb-data --save "" --appendonly no \
      --daemonize yes --loadmodule /opt/falkordb/falkordb.so \
 && until redis-cli ping 2>/dev/null | grep -q PONG; do sleep 0.2; done \
 && python scripts/02_load_curriculum.py \
 && python scripts/03_derive.py \
 && python scripts/04_build_template.py \
 && python scripts/05_new_class.py --id demo --students 30 \
 && python scripts/demo_scenario.py \
 && redis-cli SAVE \
 && (redis-cli SHUTDOWN NOSAVE || true) \
 && test -s /app/falkordb-data/dump.rdb

# TIMEOUT is 30 s here, not compose's 1 s: on the free tier's 0.1 CPU, betweenness over the curriculum graph
# (bridges) takes about 7 s. Two query threads keep FalkorDB's memory down.
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    FALKOR_SOCKET=/tmp/falkordb.sock \
    FALKORDB_ARGS="THREAD_COUNT 2 MAX_QUEUED_QUERIES 256 TIMEOUT 30000 RESULTSET_SIZE 10000"

COPY --chown=unlearn deploy/render-entrypoint.sh /app/deploy/render-entrypoint.sh
EXPOSE 10000
CMD ["bash", "/app/deploy/render-entrypoint.sh"]
