# FalkorDB
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_PASSWORD=change-me

# LLM providers (later phases)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: override provider models, or set UNLEARN_LLM=template to skip every provider.
GROQ_MODEL=
# Gemini models tried in order (each has its own free-tier daily quota):
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
OPENROUTER_MODEL=
UNLEARN_LLM=auto
# Ollama. The eval always uses it (localhost by default). Set OLLAMA_BASE_URL (e.g. http://localhost:11434/v1)
# only to make the app use your local model first, e.g. to record the demo; leave it empty otherwise.
# Only the dev compose profile passes it (prod never does). From inside Docker: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:27b-q4_K_M
