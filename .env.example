# FalkorDB
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_PASSWORD=change-me

# LLM providers (later phases)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: override provider models, or set UNLEARN_LLM=template to skip every provider.
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
UNLEARN_LLM=auto
# Local eval only (never used by the app): Ollama's OpenAI-compatible endpoint and the eval model.
# From inside Docker use http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:27b-q4_K_M
